; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-linux-android | FileCheck %s

; Without an fp128 sincos libcall, llvm.sincos.f128 (which InstCombine forms
; from a sin and a cos of the same value) lowers to separate sin and cos
; libcalls instead of failing with "no libcall available for fsincos".

define { fp128, fp128 } @test_sincos_f128(fp128 %x) nounwind {
; CHECK-LABEL: test_sincos_f128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    subq $40, %rsp
; CHECK-NEXT:    movaps %xmm0, (%rsp) # 16-byte Spill
; CHECK-NEXT:    callq sinl@PLT
; CHECK-NEXT:    movaps %xmm0, {{[-0-9]+}}(%r{{[sb]}}p) # 16-byte Spill
; CHECK-NEXT:    movaps (%rsp), %xmm0 # 16-byte Reload
; CHECK-NEXT:    callq cosl@PLT
; CHECK-NEXT:    movaps %xmm0, %xmm1
; CHECK-NEXT:    movaps {{[-0-9]+}}(%r{{[sb]}}p), %xmm0 # 16-byte Reload
; CHECK-NEXT:    addq $40, %rsp
; CHECK-NEXT:    retq
  %r = call { fp128, fp128 } @llvm.sincos.f128(fp128 %x)
  ret { fp128, fp128 } %r
}
