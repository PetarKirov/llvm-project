; enumeration before casting to DIBasicType. Generated by LDC from:
;
;   __gshared int sink;
;   pragma(inline, true) void use(Outer o) { sink = o == Outer.y ? 1 : 2; }
;   void callsWithConstant() { use(Outer.y); }

